#!/bin/sh

# Auth comes from an npm trusted publisher: the CI job sets NPM_ID_TOKEN to a
# CircleCI OIDC token and npm exchanges it for a short-lived publish token.
if [ -z "$NPM_ID_TOKEN" ]; then
    echo "NPM_ID_TOKEN is not set; cannot authenticate to npm" >&2
    exit 1
fi

TAG=beta
if [ "$MB_RELEASE" = "true" ]; then
    TAG=latest
fi

cd dist/mountebank
npm publish . --tag $TAG --access public
